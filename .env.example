# ══════════════════════════════════════════════
#  Crypto Trading Pipeline — Environment Config
# ══════════════════════════════════════════════

# ── Database ───────────────────────────────────
POSTGRES_DB=trading_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Timezone ───────────────────────────────────
TZ=Asia/Jakarta

# ── Binance API ────────────────────────────────
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=5m
BINANCE_KLINE_LIMIT=500

# ── WebSocket ──────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@kline_5m
BINANCE_WS_PING_INTERVAL=20
BINANCE_WS_SESSION_MAX=82800

# ── Indicator ──────────────────────────────────
INDICATOR_WINDOW=500
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STDDEV=2.0
STOCH_K_PERIOD=14
STOCH_D_PERIOD=3
